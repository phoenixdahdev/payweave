{
  "name": "payweave-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "changeset": "changeset",
    "version": "changeset version && node packages/payweave/scripts/sync-version.mjs",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@payweave/eslint-config": "workspace:*",
    "@payweave/typescript-config": "workspace:*",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20"
  }
}
